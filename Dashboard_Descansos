function fillSelect(sel, vals, keep="") {
  const current = keep || sel.value;
  sel.innerHTML = '<option value="">Todos</option>' + vals.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join("");
  if(vals.includes(current)) sel.value = current;
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function badgeClass(status) {
  if(status === "SIN CLASIFICAR") return "SIN";
  return status;
}

function applyFilters(updateDependent=true) {
  const search = qs("fSearch").value.trim().toLowerCase();
  filtered = DATA.filter(d => {
    const pass = Object.entries(filters).every(([key, el]) => !el.value || d[key] === el.value);
    const text = `${d["Nombre del operador"]} ${d["Nomina"]} ${d["Planta"]} ${d["Gerente"]} ${d["Jefe Operativo"]} ${d["Coordinador"]}`.toLowerCase();
    return pass && (!search || text.includes(search));
  });

  if(updateDependent) {
    const gerenteVal = filters.Gerente.value;
    const jefeVal = filters["Jefe Operativo"].value;
    const coordVal = filters.Coordinador.value;
    const estVal = filters.Estatus.value;

    const baseForJefe = DATA.filter(d => !gerenteVal || d.Gerente === gerenteVal);
    const baseForCoord = baseForJefe.filter(d => !jefeVal || d["Jefe Operativo"] === jefeVal);
    fillSelect(filters["Jefe Operativo"], uniqueVals("Jefe Operativo", baseForJefe), jefeVal);
    fillSelect(filters.Coordinador, uniqueVals("Coordinador", baseForCoord), coordVal);
    fillSelect(filters.Estatus, uniqueVals("Estatus", DATA), estVal);
  }

  sortData();
  render();
}

function sortData() {
  const dir = sortState.dir === "asc" ? 1 : -1;
  filtered.sort((a,b) => {
    const av = a[sortState.key], bv = b[sortState.key];
    if(typeof av === "number" && typeof bv === "number") return (av-bv)*dir;
    return String(av).localeCompare(String(bv))*dir;
  });
}

function countBy(key, data=filtered) {
  const m = new Map();
  data.forEach(d => m.set(d[key] || "Sin dato", (m.get(d[key] || "Sin dato") || 0) + 1));
  return [...m.entries()].sort((a,b)=>b[1]-a[1]);
}

function renderBars(id, key, limit=8) {
  const container = qs(id);
  const rows = countBy(key).slice(0, limit);
  const max = Math.max(1, ...rows.map(r=>r[1]));
  container.innerHTML = rows.map(([label,val]) => `
    <div class="barItem">
      <div class="barLabel" title="${escapeHtml(label)}">${escapeHtml(label)}</div>
      <div class="barTrack"><div class="barFill" style="width:${Math.max(4, val/max*100)}%"></div></div>
      <div class="barValue">${val}</div>
    </div>
  `).join("") || '<div class="footerNote">Sin datos visibles.</div>';
}

function hhmm(hours) {
  const m = Math.round((Number(hours)||0)*60);
  return `${String(Math.floor(m/60)).padStart(2,"0")}:${String(m%60).padStart(2,"0")}`;
}

function render() {
  const n = filtered.length;
  const counts = Object.fromEntries(["CRÍTICO","ALTO","MEDIO","BAJO","SIN CLASIFICAR"].map(s => [s, filtered.filter(d=>d.Estatus===s).length]));
  const maxDias = n ? Math.max(...filtered.map(d=>Number(d["Días sin descanso"])||0)) : 0;
  const maxHoras = n ? Math.max(...filtered.map(d=>Number(d["Horas de conducción"])||0)) : 0;
  qs("kTotal").textContent = n.toLocaleString("es-MX");
  qs("kNoUsar").textContent = ((counts["CRÍTICO"]||0)+(counts["ALTO"]||0)).toLocaleString("es-MX");
  qs("kMaxDias").textContent = maxDias;
  qs("kMaxHoras").textContent = hhmm(maxHoras);
  qs("kMedio").textContent = counts["MEDIO"] || 0;
  qs("kBajo").textContent = counts["BAJO"] || 0;
  qs("sCrit").textContent = counts["CRÍTICO"] || 0;
  qs("sAlto").textContent = counts["ALTO"] || 0;
  qs("sMedio").textContent = counts["MEDIO"] || 0;
  qs("sBajo").textContent = counts["BAJO"] || 0;
  qs("sSin").textContent = counts["SIN CLASIFICAR"] || 0;
  qs("dataNote").innerHTML = `<b>Nota de validación:</b> ${escapeHtml(JORNADA_NOTE)}`;

  renderBars("gerenteBars", "Gerente");
  renderBars("jefeBars", "Jefe Operativo");
  renderBars("coordBars", "Coordinador");

  const tbody = qs("dataTable").querySelector("tbody");
  tbody.innerHTML = filtered.map(d => `
    <tr>
      <td><span class="badge ${badgeClass(d.Estatus)}">${escapeHtml(d.Estatus)}</span></td>
      <td>${escapeHtml(d.Nomina)}</td>
      <td><b>${escapeHtml(d["Nombre del operador"])}</b></td>
      <td>${escapeHtml(d["Días sin descanso"])}</td>
      <td>${escapeHtml(d["Días laborados"])}</td>
      <td>${escapeHtml(d["Jornadas >11:30"])}</td>
      <td><b>${escapeHtml(d["Horas conducción"])}</b></td>
      <td>${escapeHtml(d.Gerente)}</td>
      <td>${escapeHtml(d["Jefe Operativo"])}</td>
      <td>${escapeHtml(d.Coordinador)}</td>
      <td>${escapeHtml(d.Planta)}</td>
      <td>${escapeHtml(d["Status del Operador"])}</td>
    </tr>
  `).join("");
}

Object.entries(filters).forEach(([key, el]) => el.addEventListener("change", () => applyFilters(true)));
qs("fSearch").addEventListener("input", () => applyFilters(false));
qs("clearBtn").addEventListener("click", () => {
  Object.values(filters).forEach(el => el.value = "");
  qs("fSearch").value = "";
  applyFilters(true);
});
qs("sortHours").addEventListener("change", e => {
  sortState = {key:"Horas de conducción", dir:e.target.value};
  sortData(); render();
});
document.querySelectorAll("th[data-key]").forEach(th => {
  th.addEventListener("click", () => {
    const key = th.dataset.key;
    sortState = {key, dir: (sortState.key===key && sortState.dir==="desc") ? "asc" : "desc"};
    sortData(); render();
  });
});

fillSelect(filters.Gerente, uniqueVals("Gerente"));
fillSelect(filters["Jefe Operativo"], uniqueVals("Jefe Operativo"));
fillSelect(filters.Coordinador, uniqueVals("Coordinador"));
fillSelect(filters.Estatus, uniqueVals("Estatus"));
applyFilters(true);
</script>
</body>
</html>
