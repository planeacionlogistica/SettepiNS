<style>
:root {
  --bg:#eef2f7; --panel:#ffffff; --nav:#172234; --nav2:#111827;
  --blue:#1f3b64; --green:#76c43b; --yellow:#f6c343; --orange:#f58220;
  --red:#d71920; --text:#111827; --muted:#6b7280; --line:#d7dee9;
  --black:#262a31; --soft:#f7f9fc;
}
* { box-sizing:border-box; }
body { margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; background:var(--bg); color:var(--text); }
.header {
  height:64px; background:var(--nav); display:flex; align-items:center; padding:0 28px; color:white;
  box-shadow:0 2px 12px rgba(0,0,0,.18); position:sticky; top:0; z-index:20;
}
.logo { font-weight:900; letter-spacing:.5px; color:#81d742; font-size:22px; margin-right:30px; }
.titleBlock { line-height:1.05; }
.titleBlock h1 { margin:0; font-size:18px; letter-spacing:.5px; font-weight:850; }
.titleBlock p { margin:5px 0 0 0; font-size:11px; color:#cbd5e1; letter-spacing:1.8px; text-transform:uppercase; }
.main { display:grid; grid-template-columns:230px 1fr; min-height:calc(100vh - 64px); }
.sidebar {
  background:#f7f9fc; border-right:1px solid var(--line); padding:14px 12px; position:sticky; top:64px; height:calc(100vh - 64px); overflow:auto;
}
.sideTitle { font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:2px; font-weight:800; margin-bottom:12px; }
.filterGroup { margin-bottom:12px; }
.filterGroup label { display:block; font-size:10px; color:#64748b; font-weight:850; text-transform:uppercase; letter-spacing:.8px; margin:0 0 5px; }
select,input {
  width:100%; border:1px solid #cbd5e1; background:#fff; border-radius:7px; min-height:34px; padding:7px 9px;
  color:#172034; font-size:12px; outline:none;
}
button {
  width:100%; border:1px solid #81d742; background:#fff; color:#2a6413; border-radius:8px; padding:9px 8px;
  font-weight:800; cursor:pointer;
}
.content { padding:18px 22px 28px; overflow:hidden; }
.tabs { display:flex; gap:30px; align-items:center; height:30px; margin-bottom:16px; font-size:13px; font-weight:800; color:#64748b; }
.tabActive { color:#172234; border-bottom:3px solid #81d742; padding-bottom:8px; }
.kpis { display:grid; grid-template-columns:repeat(6,minmax(145px,1fr)); gap:12px; margin-bottom:16px; }
.kpi {
  background:var(--panel); border-radius:12px; padding:14px 16px; min-height:84px; box-shadow:0 4px 16px rgba(15,23,42,.08);
  border-top:3px solid #111827; position:relative; overflow:hidden;
}
.kpi:after {
  content:""; position:absolute; right:-16px; bottom:-22px; width:80px; height:80px; border-radius:50%; background:#f1f5f9;
}
.kpi.orange { border-top-color:var(--orange); }
.kpi.red { border-top-color:var(--red); }
.kpi.green { border-top-color:var(--green); }
.kpi.yellow { border-top-color:var(--yellow); }
.kpi.blue { border-top-color:#2563eb; }
.kpi .value { font-size:26px; font-weight:900; letter-spacing:.4px; margin-bottom:4px; }
.kpi.red .value { color:var(--red); } .kpi.orange .value { color:var(--orange); }
.kpi.green .value { color:#4c9f24; } .kpi.yellow .value { color:#b77900; } .kpi.blue .value { color:#2563eb; }
.kpi .label { color:#64748b; font-size:10px; font-weight:850; text-transform:uppercase; letter-spacing:1.1px; }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:16px; }
.card {
  background:var(--panel); border-radius:12px; padding:16px; box-shadow:0 4px 16px rgba(15,23,42,.08);
}
.card h2 { margin:0 0 12px; font-size:15px; }
.note {
  background:#fff7ed; border-left:5px solid var(--orange); color:#7c2d12; padding:10px 12px; border-radius:8px; font-size:12px; line-height:1.45; margin-bottom:14px;
}
.statusRow { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; }
.statusBox { border-radius:10px; padding:12px; color:white; min-height:78px; }
.statusBox .n { font-size:24px; font-weight:900; }
.statusBox .t { font-size:11px; font-weight:850; letter-spacing:.8px; margin-top:4px; }
.crit { background:var(--red); } .alto { background:var(--orange); } .medio { background:#fbbf24; color:#332200; }
.bajo { background:#4c9f24; } .sin { background:#64748b; }
.barList { display:flex; flex-direction:column; gap:9px; }
.barItem { display:grid; grid-template-columns:170px 1fr 48px; align-items:center; gap:10px; font-size:12px; }
.barLabel { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:#334155; font-weight:750; }
.barTrack { height:15px; background:#e5e7eb; border-radius:999px; overflow:hidden; }
.barFill { height:100%; background:#172234; border-radius:999px; }
.barValue { text-align:right; font-weight:900; }
.tableCard { background:var(--panel); border-radius:12px; box-shadow:0 4px 16px rgba(15,23,42,.08); overflow:hidden; }
.tableHeader { display:flex; justify-content:space-between; align-items:center; padding:14px 16px; border-bottom:1px solid var(--line); }
.tableHeader h2 { margin:0; font-size:15px; }
.sortControl { display:flex; gap:8px; align-items:center; font-size:12px; color:#64748b; }
.sortControl select { width:190px; }
.tableWrap { max-height:560px; overflow:auto; }
table { width:100%; border-collapse:collapse; font-size:12px; }
thead th {
  position:sticky; top:0; background:#172234; color:#fff; text-align:left; padding:10px 9px; font-size:11px; text-transform:uppercase; letter-spacing:.45px; cursor:pointer;
}
tbody td { padding:9px; border-bottom:1px solid #e5e7eb; vertical-align:middle; }
tbody tr:hover { background:#f8fafc; }
.badge { display:inline-flex; align-items:center; justify-content:center; border-radius:999px; padding:4px 8px; font-size:10px; font-weight:900; letter-spacing:.4px; color:white; }
.badge.CRÍTICO { background:var(--red); } .badge.ALTO { background:var(--orange); }
.badge.MEDIO { background:#fbbf24; color:#3b2a00; } .badge.BAJO { background:#4c9f24; }
.badge.SIN { background:#64748b; }
.footerNote { color:#64748b; font-size:11px; margin-top:10px; }
@media(max-width:1100px) {
  .main { grid-template-columns:1fr; }
  .sidebar { position:relative; top:0; height:auto; display:grid; grid-template-columns:repeat(2,1fr); gap:8px; }
  .sideTitle { grid-column:1 / -1; }
  .kpis { grid-template-columns:repeat(2,1fr); }
  .grid2 { grid-template-columns:1fr; }
  .statusRow { grid-template-columns:repeat(2,1fr); }
}
</style>
</head>
